```json
{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "apps/builder/out",
  "framework": "nextjs",
  "nodejs": "20.x",
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["sfo1", "iad1"],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/old-path",
      "destination": "/new-path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
```
