{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/builder/dist",
  "framework": "react",
  "nodejs": "20.x",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
